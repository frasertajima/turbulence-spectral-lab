! experiment_003.cuf - Burgers turbulence: real PDE cross-scale coupling
!
! This is the key experiment: can neural networks learn the cross-scale
! coupling that arises from actual PDE dynamics?
!
! Method:
!   1. Generate random smooth initial condition (low-k modes)
!   2. Solve 2D viscous Burgers equation to develop fine structure
!   3. The nonlinear term u*du/dx creates genuine cross-scale coupling
!   4. Low-pass filter the evolved field -> coarse input
!   5. Train FNO/CNN to predict fine - coarse residual
!
! Key difference from experiments 001/002:
!   - The fine structure is generated by PHYSICS, not by hand
!   - The relationship between scales is whatever the PDE produces
!   - We don't know in advance what the network needs to learn
!
! Compile:
!   nvfortran -cuda -gpu=cc80,cc86,cc89,cc90 -O3 -lcufft \
!     spectral_tools.cuf synthetic_turbulence.cuf burgers_solver.cuf \
!     experiment_003.cuf -o experiment_003
!
! Run:
!   ./experiment_003

program experiment_003
    use cudafor
    use spectral_tools
    use synthetic_turbulence
    use burgers_solver
    implicit none

    ! Grid size
    integer, parameter :: nx = 256, ny = 256

    ! Physics
    real(sp), parameter :: nu = 0.01_sp      ! viscosity (moderate - stable & nonlinear)
    real(sp), parameter :: Lx = TWO_PI       ! domain size
    real(sp), parameter :: Ly = TWO_PI
    real(sp), parameter :: dt = 0.001_sp     ! time step
    integer, parameter :: n_evolve = 1000    ! steps to evolve (t = 1.0)

    ! Filter cutoff (k=8: aggressive, removes IC modes k=8-16 + all fine structure)
    real(sp), parameter :: k_cutoff = 8.0_sp

    ! Training samples
    integer, parameter :: n_samples = 200

    ! Solver state
    type(burgers_state) :: solver

    ! Host arrays
    real(sp), allocatable :: u_h(:,:), v_h(:,:)
    real(sp), allocatable :: fine_h(:,:), coarse_h(:,:)

    ! Device arrays for filtering/spectrum
    real(sp), device, allocatable :: field_d(:,:), filtered_d(:,:)

    ! Spectrum
    real(sp) :: E_k(MAX_BINS), k_vals(MAX_BINS)
    integer :: n_bins

    ! Timing
    type(cudaEvent) :: start_event, stop_event
    real(4) :: elapsed_ms

    ! Variables
    integer :: sample, ierr, i, j
    real(sp) :: u_max, residual_rms
    character(len=256) :: filename, output_dir

    ! GPU info
    type(cudaDeviceProp) :: prop
    ierr = cudaGetDeviceProperties(prop, 0)

    print *, "================================================================"
    print *, "  Experiment 003: Burgers Turbulence Super-Resolution"
    print *, "================================================================"
    print *, ""
    print *, "GPU: ", trim(prop%name)
    print *, "Grid:", nx, "x", ny
    print *, "Viscosity:", nu
    print *, "Domain: [0, 2pi]^2"
    print *, "Evolution: ", n_evolve, " steps, dt =", dt, ", t_final =", n_evolve * dt
    print *, "Filter cutoff: k =", int(k_cutoff)
    print *, "Samples:", n_samples
    print *, ""

    ! Create output directories
    output_dir = "../experiments/003_burgers/"
    call execute_command_line("mkdir -p " // trim(output_dir) // "spectra")
    call execute_command_line("mkdir -p " // trim(output_dir) // "fields")

    ! Allocate host arrays
    allocate(u_h(nx, ny), v_h(nx, ny))
    allocate(fine_h(nx, ny), coarse_h(nx, ny))
    allocate(field_d(nx, ny), filtered_d(nx, ny))

    ierr = cudaEventCreate(start_event)
    ierr = cudaEventCreate(stop_event)

    ! ==========================================
    ! Part 1: Single detailed analysis
    ! ==========================================
    print *, "--- Part 1: Single run analysis ---"
    print *, ""

    ierr = cudaEventRecord(start_event, 0)

    ! Initialize solver
    call burgers_init(solver, nx, ny, nu, Lx, Ly)

    ! Generate smooth initial condition (low-k modes only)
    call generate_smooth_ic(solver, 42)

    ! Save initial spectrum
    call burgers_get_u(solver, u_h)
    field_d = u_h
    call compute_energy_spectrum_2d(field_d, nx, ny, E_k, k_vals, n_bins)
    call write_spectrum(trim(output_dir) // "spectra/spectrum_initial.dat", &
                        E_k, k_vals, n_bins)

    u_max = maxval(abs(u_h))
    print '(A,F8.4)', "  Initial max|u|: ", u_max

    ! Evolve
    print '(A,I6,A)', "  Evolving for ", n_evolve, " steps..."
    call burgers_run(solver, dt, n_evolve)

    ! Get evolved field
    call burgers_get_u(solver, fine_h)
    u_max = maxval(abs(fine_h))
    print '(A,F8.4)', "  Final max|u|:   ", u_max

    ! Stability check
    if (u_max /= u_max .or. u_max > 1.0e10) then
        print *, "  ERROR: Simulation blew up! Adjust nu/dt."
        stop 1
    end if

    ! Evolved spectrum (fine)
    field_d = fine_h
    call compute_energy_spectrum_2d(field_d, nx, ny, E_k, k_vals, n_bins)
    call write_spectrum(trim(output_dir) // "spectra/spectrum_fine.dat", &
                        E_k, k_vals, n_bins)

    ! Low-pass filter -> coarse
    call spectral_filter_2d(field_d, filtered_d, nx, ny, k_cutoff, 0)
    coarse_h = filtered_d

    ! Coarse spectrum
    field_d = coarse_h
    call compute_energy_spectrum_2d(field_d, nx, ny, E_k, k_vals, n_bins)
    call write_spectrum(trim(output_dir) // "spectra/spectrum_coarse.dat", &
                        E_k, k_vals, n_bins)

    ! Residual spectrum
    field_d = fine_h - coarse_h
    call compute_energy_spectrum_2d(field_d, nx, ny, E_k, k_vals, n_bins)
    call write_spectrum(trim(output_dir) // "spectra/spectrum_residual.dat", &
                        E_k, k_vals, n_bins)

    ! Save fields
    call write_field_2d(trim(output_dir) // "fields/fine_sample_000.bin", fine_h, nx, ny)
    call write_field_2d(trim(output_dir) // "fields/coarse_sample_000.bin", coarse_h, nx, ny)

    residual_rms = sqrt(sum((fine_h - coarse_h)**2) / real(nx * ny))
    print '(A,ES12.4)', "  Residual RMS:   ", residual_rms

    ierr = cudaEventRecord(stop_event, 0)
    ierr = cudaEventSynchronize(stop_event)
    ierr = cudaEventElapsedTime(elapsed_ms, start_event, stop_event)

    print '(A,F8.1,A)', "  Single run time: ", elapsed_ms, " ms"

    call burgers_cleanup(solver)

    ! ==========================================
    ! Part 2: Generate training dataset
    ! ==========================================
    print *, ""
    print *, "--- Part 2: Generating training dataset ---"
    print *, ""

    ierr = cudaEventRecord(start_event, 0)

    do sample = 1, n_samples
        ! Fresh solver for each sample
        call burgers_init(solver, nx, ny, nu, Lx, Ly)

        ! Different initial condition
        call generate_smooth_ic(solver, sample * 137 + 7)

        ! Evolve
        call burgers_run(solver, dt, n_evolve)

        ! Get evolved field (this is our "fine" ground truth)
        call burgers_get_u(solver, fine_h)

        ! Low-pass filter -> coarse input
        field_d = fine_h
        call spectral_filter_2d(field_d, filtered_d, nx, ny, k_cutoff, 0)
        coarse_h = filtered_d

        ! Save pair
        write(filename, '(A,A,I3.3,A)') trim(output_dir), "fields/fine_sample_", sample, ".bin"
        call write_field_2d(trim(filename), fine_h, nx, ny)

        write(filename, '(A,A,I3.3,A)') trim(output_dir), "fields/coarse_sample_", sample, ".bin"
        call write_field_2d(trim(filename), coarse_h, nx, ny)

        if (mod(sample, 20) == 0) then
            residual_rms = sqrt(sum((fine_h - coarse_h)**2) / real(nx * ny))
            print '(A,I4,A,I4,A,ES10.3)', "    Sample ", sample, " / ", n_samples, &
                  "  residual RMS = ", residual_rms
        end if

        call burgers_cleanup(solver)
    end do

    ierr = cudaEventRecord(stop_event, 0)
    ierr = cudaEventSynchronize(stop_event)
    ierr = cudaEventElapsedTime(elapsed_ms, start_event, stop_event)

    print *, ""
    print '(A,I4,A,F8.1,A)', "  Generated ", n_samples, " pairs in ", elapsed_ms / 1000.0, " s"
    print '(A,F8.1,A)', "  Rate: ", elapsed_ms / real(n_samples), " ms/sample"

    ! ==========================================
    ! Part 3: Test different viscosities
    ! ==========================================
    print *, ""
    print *, "--- Part 3: Viscosity comparison ---"
    print *, ""

    call test_viscosity(0.1_sp,  0.002_sp,  500, "nu_0.1")
    call test_viscosity(0.01_sp, 0.001_sp, 1000, "nu_0.01")
    call test_viscosity(0.005_sp, 0.0005_sp, 2000, "nu_0.005")

    print *, ""
    print *, "================================================================"
    print *, "  Experiment 003 Complete"
    print *, "================================================================"
    print *, ""
    print *, "  Output in: ", trim(output_dir)
    print *, ""
    print *, "  Next:"
    print *, "  cd ../python"
    print *, "  python analyze_spectrum.py --dir ../experiments/003_burgers/"
    print *, "  python train_fno.py --model fno --data-dir ../experiments/003_burgers/fields/"
    print *, "  python train_fno.py --model cnn --data-dir ../experiments/003_burgers/fields/"
    print *, ""

    ! Cleanup
    deallocate(u_h, v_h, fine_h, coarse_h, field_d, filtered_d)
    ierr = cudaEventDestroy(start_event)
    ierr = cudaEventDestroy(stop_event)

contains

    !=========================================================================
    ! Generate smooth initial condition: low-k random Fourier modes
    !=========================================================================
    subroutine generate_smooth_ic(state, seed)
        type(burgers_state), intent(inout) :: state
        integer, intent(in) :: seed

        real(sp), allocatable :: u_ic(:,:), v_ic(:,:)
        real(sp), device, allocatable :: u_d(:,:), v_d(:,:), filt_d(:,:)
        real(sp) :: k_ic, scale_factor, u_max_val
        integer :: nx_l, ny_l

        nx_l = state%nx
        ny_l = state%ny

        allocate(u_ic(nx_l, ny_l), v_ic(nx_l, ny_l))
        allocate(u_d(nx_l, ny_l), v_d(nx_l, ny_l), filt_d(nx_l, ny_l))

        ! Generate broadband field, then filter to keep only low modes
        ! This ensures smooth IC that the nonlinear term will steepen
        k_ic = 16.0_sp  ! only modes below k=16 in IC

        call generate_kolmogorov_2d(u_d, nx_l, ny_l, seed)
        call normalize_field_2d(u_d, nx_l, ny_l)
        call spectral_filter_2d(u_d, filt_d, nx_l, ny_l, k_ic, 0)
        u_ic = filt_d

        call generate_kolmogorov_2d(v_d, nx_l, ny_l, seed + 50000)
        call normalize_field_2d(v_d, nx_l, ny_l)
        call spectral_filter_2d(v_d, filt_d, nx_l, ny_l, k_ic, 0)
        v_ic = filt_d

        ! Scale IC so max velocity ~ 1.0 (prevents shock blowup)
        u_max_val = max(maxval(abs(u_ic)), maxval(abs(v_ic)))
        if (u_max_val > 0.0_sp) then
            scale_factor = 1.0_sp / u_max_val
            u_ic = u_ic * scale_factor
            v_ic = v_ic * scale_factor
        end if

        call burgers_set_ic(state, u_ic, v_ic)

        deallocate(u_ic, v_ic, u_d, v_d, filt_d)
    end subroutine

    !=========================================================================
    ! Test a specific viscosity and save spectrum
    !=========================================================================
    subroutine test_viscosity(test_nu, test_dt, test_nsteps, label)
        real(sp), intent(in) :: test_nu, test_dt
        integer, intent(in) :: test_nsteps
        character(len=*), intent(in) :: label

        type(burgers_state) :: test_solver
        real(sp), allocatable :: test_h(:,:)
        real(sp), device, allocatable :: test_d(:,:)
        real(sp) :: E_test(MAX_BINS), k_test(MAX_BINS)
        integer :: n_test
        real(sp) :: umax

        allocate(test_h(nx, ny), test_d(nx, ny))

        call burgers_init(test_solver, nx, ny, test_nu, Lx, Ly)
        call generate_smooth_ic(test_solver, 42)
        call burgers_run(test_solver, test_dt, test_nsteps)
        call burgers_get_u(test_solver, test_h)

        umax = maxval(abs(test_h))

        if (umax /= umax .or. umax > 1.0e10) then
            print '(A,A,A,ES9.2,A)', "  ", label, ": nu = ", test_nu, &
                  ", UNSTABLE (NaN/Inf)"
        else
            test_d = test_h
            call compute_energy_spectrum_2d(test_d, nx, ny, E_test, k_test, n_test)

            write(filename, '(A,A,A,A)') trim(output_dir), "spectra/spectrum_", trim(label), ".dat"
            call write_spectrum(trim(filename), E_test, k_test, n_test)

            print '(A,A,A,ES9.2,A,F8.4)', "  ", label, ": nu = ", test_nu, &
                  ", max|u| = ", umax
        end if

        call burgers_cleanup(test_solver)
        deallocate(test_h, test_d)
    end subroutine

end program experiment_003
