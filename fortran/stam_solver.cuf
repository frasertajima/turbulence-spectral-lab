! stam_solver.cuf - Semi-Lagrangian solver (Stam's "Stable Fluids" method)
!
! Supports two modes:
!   - Burgers (use_ns=.false., default): du/dt + u*grad(u) = nu*laplacian(u)
!   - Incompressible N-S (use_ns=.true.): adds pressure projection for div(u)=0
!
! Method:
!   - Semi-Lagrangian advection (backtrace + bilinear interpolation)
!   - Implicit Jacobi diffusion
!   - Jacobi pressure Poisson solve (N-S mode only)
!   - Periodic boundary conditions
!
! This is deliberately dissipative: the semi-Lagrangian scheme smears
! gradients, and Jacobi diffusion/pressure add numerical error. The ERROR
! relative to the pseudo-spectral solver (burgers_solver.cuf) is what
! we want to learn to correct with a neural network.
!
! Compile (as part of experiment_005):
!   nvfortran -cuda -gpu=cc89 -O3 -lcufft \
!     spectral_tools.cuf synthetic_turbulence.cuf burgers_solver.cuf \
!     stam_solver.cuf experiment_005.cuf -o experiment_005

module stam_solver
    use cudafor
    use spectral_tools, only: sp
    implicit none

    ! Jacobi iterations for diffusion (matches fluid_dynamics.cuf)
    integer, parameter :: STAM_DIFFUSE_ITERS = 20

    type :: stam_state
        integer :: nx, ny
        real(sp) :: nu        ! viscosity
        real(sp) :: Lx, Ly    ! domain size
        real(sp) :: dx, dy    ! grid spacing
        logical :: use_ns     ! .true. = incompressible N-S (with pressure projection)
                              ! .false. = Burgers (no projection, default)

        ! Velocity fields (device)
        real(sp), device, allocatable :: u(:,:), v(:,:)
        real(sp), device, allocatable :: u_prev(:,:), v_prev(:,:)

        ! Pressure projection work arrays (allocated only when use_ns=.true.)
        real(sp), device, allocatable :: p(:,:), div(:,:)

        ! Wall boundary mode (clamp instead of periodic wrap)
        logical :: use_walls = .false.

        ! Passive density tracer (allocated only when has_density=.true.)
        logical :: has_density = .false.
        real(sp) :: diffusion_rho = 0.0_sp   ! density diffusion coefficient
        real(sp) :: decay_rho = 0.0_sp       ! density decay rate (per second)
        real(sp), device, allocatable :: rho(:,:), rho_prev(:,:)

        ! Obstacle mask (0=fluid, 1=obstacle) — always allocated
        integer(1), device, allocatable :: obstacle(:,:)

        ! Uniform wind forcing (continuous, applied per timestep)
        real(sp) :: wind_fx = 0.0_sp
        real(sp) :: wind_fy = 0.0_sp
    end type

contains

    !=========================================================================
    ! Initialize solver state
    !=========================================================================
    subroutine stam_init(state, nx, ny, nu, Lx, Ly)
        type(stam_state), intent(inout) :: state
        integer, intent(in) :: nx, ny
        real(sp), intent(in) :: nu, Lx, Ly

        state%nx = nx
        state%ny = ny
        state%nu = nu
        state%Lx = Lx
        state%Ly = Ly
        state%dx = Lx / real(nx, sp)
        state%dy = Ly / real(ny, sp)
        state%use_ns = .false.   ! default: Burgers (no pressure projection)

        allocate(state%u(nx, ny), state%v(nx, ny))
        allocate(state%u_prev(nx, ny), state%v_prev(nx, ny))
        allocate(state%obstacle(nx, ny))

        state%u = 0.0_sp
        state%v = 0.0_sp
        state%u_prev = 0.0_sp
        state%v_prev = 0.0_sp
        state%obstacle = 0_1
    end subroutine

    !=========================================================================
    ! Enable Navier-Stokes mode (allocate pressure arrays)
    !=========================================================================
    subroutine stam_enable_ns(state)
        type(stam_state), intent(inout) :: state

        state%use_ns = .true.
        if (.not. allocated(state%p)) then
            allocate(state%p(state%nx, state%ny))
            allocate(state%div(state%nx, state%ny))
            state%p = 0.0_sp
            state%div = 0.0_sp
        end if
    end subroutine

    !=========================================================================
    ! Enable/disable absorbing (open) boundaries
    !=========================================================================
    subroutine stam_set_walls(state, enabled)
        type(stam_state), intent(inout) :: state
        logical, intent(in) :: enabled

        state%use_walls = enabled
    end subroutine

    !=========================================================================
    ! Set obstacle mask (copy from host to device)
    !=========================================================================
    subroutine stam_set_obstacle(state, mask_h)
        type(stam_state), intent(inout) :: state
        integer(1), intent(in) :: mask_h(state%nx, state%ny)

        state%obstacle = mask_h
    end subroutine

    !=========================================================================
    ! Set uniform wind forcing
    !=========================================================================
    subroutine stam_set_wind(state, fx, fy)
        type(stam_state), intent(inout) :: state
        real(sp), intent(in) :: fx, fy

        state%wind_fx = fx
        state%wind_fy = fy
    end subroutine

    !=========================================================================
    ! Enable passive density tracer (allocate arrays, set params)
    !=========================================================================
    subroutine stam_enable_density(state, diffusion, decay)
        type(stam_state), intent(inout) :: state
        real(sp), intent(in) :: diffusion, decay

        state%has_density = .true.
        state%diffusion_rho = diffusion
        state%decay_rho = decay
        if (.not. allocated(state%rho)) then
            allocate(state%rho(state%nx, state%ny))
            allocate(state%rho_prev(state%nx, state%ny))
            state%rho = 0.0_sp
            state%rho_prev = 0.0_sp
        end if
    end subroutine

    !=========================================================================
    ! Get/set density (copy between device and host)
    !=========================================================================
    subroutine stam_get_rho(state, rho_h)
        type(stam_state), intent(in) :: state
        real(sp), intent(out) :: rho_h(state%nx, state%ny)

        rho_h = state%rho
    end subroutine

    subroutine stam_set_rho(state, rho_h)
        type(stam_state), intent(inout) :: state
        real(sp), intent(in) :: rho_h(state%nx, state%ny)

        state%rho = rho_h
    end subroutine

    !=========================================================================
    ! Set initial condition from host arrays
    !=========================================================================
    subroutine stam_set_ic(state, u_h, v_h)
        type(stam_state), intent(inout) :: state
        real(sp), intent(in) :: u_h(state%nx, state%ny)
        real(sp), intent(in) :: v_h(state%nx, state%ny)

        state%u = u_h
        state%v = v_h
    end subroutine

    !=========================================================================
    ! Get solution (copy u from device to host)
    !=========================================================================
    subroutine stam_get_u(state, u_h)
        type(stam_state), intent(in) :: state
        real(sp), intent(out) :: u_h(state%nx, state%ny)

        u_h = state%u
    end subroutine

    subroutine stam_get_v(state, v_h)
        type(stam_state), intent(in) :: state
        real(sp), intent(out) :: v_h(state%nx, state%ny)

        v_h = state%v
    end subroutine

    !=========================================================================
    ! Semi-Lagrangian advection kernel (periodic BCs)
    !
    ! For Burgers: velocity advects itself (u advects u, v advects v)
    ! Backtrace: x_old = x - dt * u(x)
    ! Bilinear interpolation from source field at x_old
    ! Periodic wrap via modulo
    !=========================================================================
    attributes(global) subroutine advect_periodic_kernel(d_out, d0, u, v, dt, nx, ny)
        real(sp), device, intent(out) :: d_out(nx, ny)
        real(sp), device, intent(in) :: d0(nx, ny), u(nx, ny), v(nx, ny)
        real(sp), value, intent(in) :: dt
        integer, value, intent(in) :: nx, ny

        integer :: i, j
        real(sp) :: x, y, s0, s1, t0, t1
        integer :: i0, j0, i1, j1

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        ! Backtrace: where did this fluid parcel come from?
        ! Position in grid units (1-indexed)
        x = real(i, sp) - dt * real(nx, sp) * u(i, j)
        y = real(j, sp) - dt * real(ny, sp) * v(i, j)

        ! Periodic wrap to [1, nx+1) range, then get integer/fractional parts
        x = modulo(x - 1.0_sp, real(nx, sp)) + 1.0_sp
        y = modulo(y - 1.0_sp, real(ny, sp)) + 1.0_sp

        ! Integer indices for bilinear interpolation
        i0 = int(x)
        j0 = int(y)
        if (i0 < 1) i0 = nx
        if (i0 > nx) i0 = 1
        if (j0 < 1) j0 = ny
        if (j0 > ny) j0 = 1

        ! Periodic wrap for i0+1, j0+1
        i1 = i0 + 1
        j1 = j0 + 1
        if (i1 > nx) i1 = 1
        if (j1 > ny) j1 = 1

        ! Interpolation weights
        s1 = x - real(i0, sp)
        s0 = 1.0_sp - s1
        t1 = y - real(j0, sp)
        t0 = 1.0_sp - t1

        ! Bilinear interpolation
        d_out(i, j) = s0 * (t0 * d0(i0, j0) + t1 * d0(i0, j1)) + &
                      s1 * (t0 * d0(i1, j0) + t1 * d0(i1, j1))
    end subroutine

    !=========================================================================
    ! Jacobi diffusion kernel (periodic BCs)
    !
    ! Solves: x = x0 + a * laplacian(x)  implicitly via iteration
    ! a = dt * nu * N * N  (scaled for grid spacing)
    !=========================================================================
    attributes(global) subroutine diffuse_periodic_kernel(x, x0, a, nx, ny)
        real(sp), device, intent(inout) :: x(nx, ny)
        real(sp), device, intent(in) :: x0(nx, ny)
        real(sp), value, intent(in) :: a
        integer, value, intent(in) :: nx, ny

        integer :: i, j, im, ip, jm, jp, k

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        ! Periodic neighbors
        im = i - 1; if (im < 1) im = nx
        ip = i + 1; if (ip > nx) ip = 1
        jm = j - 1; if (jm < 1) jm = ny
        jp = j + 1; if (jp > ny) jp = 1

        ! Jacobi iteration (in-place with syncthreads)
        do k = 1, STAM_DIFFUSE_ITERS
            x(i, j) = (x0(i, j) + a * (x(ip, j) + x(im, j) + &
                                        x(i, jp) + x(i, jm))) / (1.0_sp + 4.0_sp * a)
            call syncthreads()
        end do
    end subroutine

    !=========================================================================
    ! Absorbing boundary kernel: zero out a strip of width `w` at all edges
    ! Applied to any 2D field (velocity or density) when use_walls=.true.
    !=========================================================================
    attributes(global) subroutine absorb_boundary_kernel(f, w, nx, ny)
        real(sp), device, intent(inout) :: f(nx, ny)
        integer, value, intent(in) :: w, nx, ny

        integer :: i, j

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        if (i <= w .or. i > nx - w .or. j <= w .or. j > ny - w) then
            f(i, j) = 0.0_sp
        end if
    end subroutine

    !=========================================================================
    ! Decay kernel: rho = rho * (1 - decay_rate * dt)
    ! Applied per-element to fade old dye
    !=========================================================================
    attributes(global) subroutine decay_kernel(rho, decay_rate, dt, nx, ny)
        real(sp), device, intent(inout) :: rho(nx, ny)
        real(sp), value, intent(in) :: decay_rate, dt
        integer, value, intent(in) :: nx, ny

        integer :: i, j

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        rho(i, j) = rho(i, j) * (1.0_sp - decay_rate * dt)
    end subroutine

    !=========================================================================
    ! Obstacle mask kernel: zero u, v, rho at obstacle cells
    !=========================================================================
    attributes(global) subroutine apply_obstacle_kernel(u, v, rho, obstacle, has_rho, nx, ny)
        real(sp), device, intent(inout) :: u(nx, ny), v(nx, ny), rho(nx, ny)
        integer(1), device, intent(in) :: obstacle(nx, ny)
        integer, value, intent(in) :: has_rho, nx, ny

        integer :: i, j

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        if (obstacle(i, j) /= 0_1) then
            u(i, j) = 0.0_sp
            v(i, j) = 0.0_sp
            if (has_rho /= 0) rho(i, j) = 0.0_sp
        end if
    end subroutine

    !=========================================================================
    ! Wind forcing kernel: add uniform wind to non-obstacle cells
    !=========================================================================
    attributes(global) subroutine apply_wind_kernel(u, v, obstacle, wfx, wfy, dt, nx, ny)
        real(sp), device, intent(inout) :: u(nx, ny), v(nx, ny)
        integer(1), device, intent(in) :: obstacle(nx, ny)
        real(sp), value, intent(in) :: wfx, wfy, dt
        integer, value, intent(in) :: nx, ny

        integer :: i, j

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        if (obstacle(i, j) == 0_1) then
            u(i, j) = u(i, j) + wfx * dt
            v(i, j) = v(i, j) + wfy * dt
        end if
    end subroutine

    !=========================================================================
    ! Divergence kernel (periodic BCs)
    ! Computes div = -(du/dx + dv/dy) via central differences
    ! Sign convention matches fluid_dynamics.cuf: div includes the -0.5*h factor
    !=========================================================================
    attributes(global) subroutine divergence_periodic_kernel(u, v, div, nx, ny)
        real(sp), device, intent(in) :: u(nx, ny), v(nx, ny)
        real(sp), device, intent(out) :: div(nx, ny)
        integer, value, intent(in) :: nx, ny

        integer :: i, j, im, ip, jm, jp
        real(sp) :: h

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        ! Periodic neighbors
        im = i - 1; if (im < 1) im = nx
        ip = i + 1; if (ip > nx) ip = 1
        jm = j - 1; if (jm < 1) jm = ny
        jp = j + 1; if (jp > ny) jp = 1

        h = 1.0_sp / real(nx, sp)
        div(i, j) = -0.5_sp * h * (u(ip, j) - u(im, j) + v(i, jp) - v(i, jm))
    end subroutine

    !=========================================================================
    ! Pressure Poisson solve via Jacobi iteration (periodic BCs)
    ! Solves nabla^2 p = div
    ! p(i,j) = (div(i,j) + p(neighbors)) / 4
    !=========================================================================
    attributes(global) subroutine pressure_solve_periodic_kernel(p, div, nx, ny)
        real(sp), device, intent(inout) :: p(nx, ny)
        real(sp), device, intent(in) :: div(nx, ny)
        integer, value, intent(in) :: nx, ny

        integer :: i, j, im, ip, jm, jp, k

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        ! Periodic neighbors
        im = i - 1; if (im < 1) im = nx
        ip = i + 1; if (ip > nx) ip = 1
        jm = j - 1; if (jm < 1) jm = ny
        jp = j + 1; if (jp > ny) jp = 1

        do k = 1, STAM_DIFFUSE_ITERS
            p(i, j) = (div(i, j) + p(ip, j) + p(im, j) + &
                        p(i, jp) + p(i, jm)) / 4.0_sp
            call syncthreads()
        end do
    end subroutine

    !=========================================================================
    ! Subtract pressure gradient from velocity (periodic BCs)
    ! u -= 0.5 * (p(i+1) - p(i-1)) / h
    ! v -= 0.5 * (p(j+1) - p(j-1)) / h
    !=========================================================================
    attributes(global) subroutine gradient_subtract_periodic_kernel(u, v, p, nx, ny)
        real(sp), device, intent(inout) :: u(nx, ny), v(nx, ny)
        real(sp), device, intent(in) :: p(nx, ny)
        integer, value, intent(in) :: nx, ny

        integer :: i, j, im, ip, jm, jp
        real(sp) :: h

        i = (blockIdx%x - 1) * blockDim%x + threadIdx%x
        j = (blockIdx%y - 1) * blockDim%y + threadIdx%y
        if (i > nx .or. j > ny) return

        ! Periodic neighbors
        im = i - 1; if (im < 1) im = nx
        ip = i + 1; if (ip > nx) ip = 1
        jm = j - 1; if (jm < 1) jm = ny
        jp = j + 1; if (jp > ny) jp = 1

        h = 1.0_sp / real(nx, sp)
        u(i, j) = u(i, j) - 0.5_sp * (p(ip, j) - p(im, j)) / h
        v(i, j) = v(i, j) - 0.5_sp * (p(i, jp) - p(i, jm)) / h
    end subroutine

    !=========================================================================
    ! Pressure projection: make velocity field divergence-free
    ! 1. Compute divergence
    ! 2. Solve Poisson equation for pressure (Jacobi)
    ! 3. Subtract pressure gradient from velocity
    !=========================================================================
    subroutine stam_project(state)
        type(stam_state), intent(inout) :: state

        integer :: nx_l, ny_l, ierr
        type(dim3) :: grid, block

        nx_l = state%nx
        ny_l = state%ny

        block = dim3(16, 16, 1)
        grid = dim3((nx_l + 15) / 16, (ny_l + 15) / 16, 1)

        ! Reset pressure
        state%p = 0.0_sp

        ! 1. Compute divergence
        call divergence_periodic_kernel<<<grid, block>>>( &
            state%u, state%v, state%div, nx_l, ny_l)
        ierr = cudaDeviceSynchronize()

        ! 2. Solve for pressure
        call pressure_solve_periodic_kernel<<<grid, block>>>( &
            state%p, state%div, nx_l, ny_l)
        ierr = cudaDeviceSynchronize()

        ! 3. Subtract pressure gradient
        call gradient_subtract_periodic_kernel<<<grid, block>>>( &
            state%u, state%v, state%p, nx_l, ny_l)
        ierr = cudaDeviceSynchronize()
    end subroutine

    !=========================================================================
    ! One timestep
    !
    ! Burgers mode (use_ns=.false.):
    !   diffuse -> advect
    !
    ! N-S mode (use_ns=.true., matches fluid_dynamics.cuf):
    !   diffuse -> project -> advect -> project
    !=========================================================================
    subroutine stam_step(state, dt)
        type(stam_state), intent(inout) :: state
        real(sp), intent(in) :: dt

        integer :: nx_l, ny_l, ierr
        real(sp) :: a, nu_l
        type(dim3) :: grid, block

        nx_l = state%nx
        ny_l = state%ny
        nu_l = state%nu

        block = dim3(16, 16, 1)
        grid = dim3((nx_l + 15) / 16, (ny_l + 15) / 16, 1)

        ! Diffusion coefficient
        a = dt * nu_l * real(nx_l, sp) * real(nx_l, sp)

        ! --- Step 1: Copy current -> prev ---
        state%u_prev = state%u
        state%v_prev = state%v

        ! --- Step 2: Diffuse (prev -> current via Jacobi) ---
        ! Initialize current from prev before iteration
        state%u = state%u_prev
        state%v = state%v_prev
        call diffuse_periodic_kernel<<<grid, block>>>(state%u, state%u_prev, a, nx_l, ny_l)
        call diffuse_periodic_kernel<<<grid, block>>>(state%v, state%v_prev, a, nx_l, ny_l)
        ierr = cudaDeviceSynchronize()

        ! --- Step 2a: Apply wind forcing (before advection) ---
        if (state%wind_fx /= 0.0_sp .or. state%wind_fy /= 0.0_sp) then
            call apply_wind_kernel<<<grid, block>>>(state%u, state%v, &
                state%obstacle, state%wind_fx, state%wind_fy, dt, nx_l, ny_l)
            ierr = cudaDeviceSynchronize()
        end if

        ! --- Step 2b (N-S only): Project after diffusion ---
        if (state%use_ns) call stam_project(state)

        ! --- Step 3: Swap for advection ---
        state%u_prev = state%u
        state%v_prev = state%v

        ! --- Step 4: Advect (semi-Lagrangian) ---
        call advect_periodic_kernel<<<grid, block>>>( &
            state%u, state%u_prev, state%u_prev, state%v_prev, dt, nx_l, ny_l)
        call advect_periodic_kernel<<<grid, block>>>( &
            state%v, state%v_prev, state%u_prev, state%v_prev, dt, nx_l, ny_l)
        ierr = cudaDeviceSynchronize()

        ! --- Step 4b (N-S only): Project after advection ---
        if (state%use_ns) call stam_project(state)

        ! --- Step 4c: Enforce obstacle mask on velocity ---
        if (state%has_density) then
            call apply_obstacle_kernel<<<grid, block>>>(state%u, state%v, &
                state%rho, state%obstacle, 1, nx_l, ny_l)
        else
            call apply_obstacle_kernel<<<grid, block>>>(state%u, state%v, &
                state%u, state%obstacle, 0, nx_l, ny_l)
        end if
        ierr = cudaDeviceSynchronize()

        ! --- Step 5: Density tracer (passive scalar) ---
        if (state%has_density) then
            ! Diffuse density
            a = dt * state%diffusion_rho * real(nx_l, sp) * real(nx_l, sp)
            state%rho_prev = state%rho
            state%rho = state%rho_prev
            call diffuse_periodic_kernel<<<grid, block>>>( &
                state%rho, state%rho_prev, a, nx_l, ny_l)
            ierr = cudaDeviceSynchronize()

            ! Advect density by velocity field
            state%rho_prev = state%rho
            call advect_periodic_kernel<<<grid, block>>>( &
                state%rho, state%rho_prev, state%u, state%v, dt, nx_l, ny_l)
            ierr = cudaDeviceSynchronize()

            ! Decay (fade old dye)
            if (state%decay_rho > 0.0_sp) then
                call decay_kernel<<<grid, block>>>( &
                    state%rho, state%decay_rho, dt, nx_l, ny_l)
                ierr = cudaDeviceSynchronize()
            end if

            ! Zero density that leaked into obstacles
            call apply_obstacle_kernel<<<grid, block>>>(state%u, state%v, &
                state%rho, state%obstacle, 1, nx_l, ny_l)
            ierr = cudaDeviceSynchronize()
        end if

        ! --- Step 6: Absorbing boundaries (zero edges so fluid doesn't wrap) ---
        if (state%use_walls) then
            call absorb_boundary_kernel<<<grid, block>>>(state%u, 2, nx_l, ny_l)
            call absorb_boundary_kernel<<<grid, block>>>(state%v, 2, nx_l, ny_l)
            if (state%has_density) then
                call absorb_boundary_kernel<<<grid, block>>>(state%rho, 2, nx_l, ny_l)
            end if
            ierr = cudaDeviceSynchronize()
        end if
    end subroutine

    !=========================================================================
    ! Run for n_steps
    !=========================================================================
    subroutine stam_run(state, dt, n_steps)
        type(stam_state), intent(inout) :: state
        real(sp), intent(in) :: dt
        integer, intent(in) :: n_steps
        integer :: step

        do step = 1, n_steps
            call stam_step(state, dt)
        end do
    end subroutine

    !=========================================================================
    ! Cleanup
    !=========================================================================
    subroutine stam_cleanup(state)
        type(stam_state), intent(inout) :: state

        if (allocated(state%u)) deallocate(state%u)
        if (allocated(state%v)) deallocate(state%v)
        if (allocated(state%u_prev)) deallocate(state%u_prev)
        if (allocated(state%v_prev)) deallocate(state%v_prev)
        if (allocated(state%p)) deallocate(state%p)
        if (allocated(state%div)) deallocate(state%div)
        if (allocated(state%rho)) deallocate(state%rho)
        if (allocated(state%rho_prev)) deallocate(state%rho_prev)
        if (allocated(state%obstacle)) deallocate(state%obstacle)
    end subroutine

end module stam_solver
